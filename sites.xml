@echo off
echo Step 1: Checking Administrator rights...
net session >nul 2>&1
if %errorLevel% == 0 (
    echo Success: Admin rights confirmed.
) else (
    echo ERROR: Please right-click and run as Administrator.
    pause
    exit
)

echo Step 2: Creating folder C:\EdgeIEMode...
if not exist "C:\EdgeIEMode" mkdir "C:\EdgeIEMode"

echo Step 3: Creating sites.xml file...
REM Записываем файл построчно, чтобы избежать ошибок синтаксиса
echo ^<site-list version="10"^> > "C:\EdgeIEMode\sites.xml"
echo ^<site url="e-respondent.belstat.gov.by"^> >> "C:\EdgeIEMode\sites.xml"
echo ^<compat-mode^>Default^</compat-mode^> >> "C:\EdgeIEMode\sites.xml"
echo ^<open-in^>IE11^</open-in^> >> "C:\EdgeIEMode\sites.xml"
echo ^</site^> >> "C:\EdgeIEMode\sites.xml"
echo ^<site url="portal2.ssf.gov.by"^> >> "C:\EdgeIEMode\sites.xml"
echo ^<compat-mode^>Default^</compat-mode^> >> "C:\EdgeIEMode\sites.xml"
echo ^<open-in^>IE11^</open-in^> >> "C:\EdgeIEMode\sites.xml"
echo ^</site^> >> "C:\EdgeIEMode\sites.xml"
echo ^</site-list^> >> "C:\EdgeIEMode\sites.xml"

echo Step 4: Updating Registry...
reg add "HKLM\SOFTWARE\Policies\Microsoft\Edge" /v "InternetExplorerIntegrationLevel" /t REG_DWORD /d 1 /f
reg add "HKLM\SOFTWARE\Policies\Microsoft\Edge" /v "InternetExplorerIntegrationSiteList" /t REG_SZ /d "file:///C:/EdgeIEMode/sites.xml" /f

echo.
echo =======================================================
echo DONE! Settings applied.
echo Please restart Microsoft Edge completely.
echo =======================================================
pause
