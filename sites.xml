@echo off
chcp 65001 >nul
echo Начинаем настройку вечного режима IE...

:: Проверка прав администратора
net session >nul 2>&1
if %errorLevel% == 0 (
    echo Права администратора подтверждены.
) else (
    echo =====================================================
    echo ОШИБКА: Запустите этот файл от имени АДМИНИСТРАТОРА!
    echo (Правая кнопка мыши - Запуск от имени администратора)
    echo =====================================================
    pause
    exit
)

:: 1. Создаем папку для списка сайтов (скрытую от глаз, чтобы случайно не удалили)
if not exist "C:\EdgeIEMode" mkdir "C:\EdgeIEMode"

:: 2. Создаем файл sites.xml с вашими ссылками
(
echo ^<site-list version="10"^>
echo   ^<site url="e-respondent.belstat.gov.by"^>
echo     ^<compat-mode^>Default^</compat-mode^>
echo     ^<open-in^>IE11^</open-in^>
echo   ^</site^>
echo   ^<site url="portal2.ssf.gov.by"^>
echo     ^<compat-mode^>Default^</compat-mode^>
echo     ^<open-in^>IE11^</open-in^>
echo   ^</site^>
echo ^</site-list^>
) > "C:\EdgeIEMode\sites.xml"

echo Файл списка сайтов создан успешно.

:: 3. Вносим изменения в реестр
echo Настройка реестра...

:: Включаем интеграцию IE
reg add "HKLM\SOFTWARE\Policies\Microsoft\Edge" /v "InternetExplorerIntegrationLevel" /t REG_DWORD /d 1 /f >nul

:: Указываем путь к нашему файлу
reg add "HKLM\SOFTWARE\Policies\Microsoft\Edge" /v "InternetExplorerIntegrationSiteList" /t REG_SZ /d "file:///C:/EdgeIEMode/sites.xml" /f >nul

echo.
echo ==========================================
echo ГОТОВО! Настройка завершена.
echo Теперь перезапустите браузер Microsoft Edge.
echo Таймер в 30 дней больше не будет вас беспокоить.
echo ==========================================
pause
