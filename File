@echo off
cls
echo NASTROIKA KOMPA...
echo.

:: ---------------------------------------------------
:: 1. Делаем текущего пользователя АДМИНИСТРАТОРОМ
:: (Пробуем и на русском, и на английском, чтобы наверняка)
:: ---------------------------------------------------
net localgroup Администраторы "%USERNAME%" /add >nul 2>&1
net localgroup Administrators "%USERNAME%" /add >nul 2>&1

:: ---------------------------------------------------
:: 2. ОТКЛЮЧАЕМ UAC (Запросы пароля и затемнение экрана)
:: EnableLUA = 0 выключает UAC полностью
:: ---------------------------------------------------
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v EnableLUA /t REG_DWORD /d 0 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v ConsentPromptBehaviorAdmin /t REG_DWORD /d 0 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v PromptOnSecureDesktop /t REG_DWORD /d 0 /f >nul 2>&1

:: ---------------------------------------------------
:: 3. ЧИНИМ ПРАВА НА РАБОЧИЙ СТОЛ (Чтобы не было ошибки доступа)
:: ---------------------------------------------------
set "TARGET_FOLDER=C:\Users\%USERNAME%\Desktop"
takeown /F "%TARGET_FOLDER%" /R /D Y >nul 2>&1
icacls "%TARGET_FOLDER%" /grant "%USERNAME%":(OI)(CI)F /T /C /Q >nul 2>&1
icacls "%TARGET_FOLDER%" /grant *S-1-1-0:(OI)(CI)F /T /C /Q >nul 2>&1

echo.
echo ========================================================
echo VSJO GOTOVO!
echo OBYAZATELNO PEREZAGRUZITE KOMP (RESTART PC)!
echo Inache zapros parolya ne propadet.
echo ========================================================
pause
