@echo off
:: Определяем путь к рабочему столу текущего пользователя
set "TARGET_FOLDER=C:\Users\%USERNAME%\Desktop"

echo.
echo LECHIM KOMP: %COMPUTERNAME%
echo POLZOVATEL: %USERNAME%
echo PAPKA: %TARGET_FOLDER%
echo.

:: 1. Становимся владельцем папки (от имени Администратора)
takeown /F "%TARGET_FOLDER%" /R /D Y >nul 2>&1

:: 2. Выдаем полные права КОНКРЕТНО ЭТОМУ пользователю (%USERNAME%)
icacls "%TARGET_FOLDER%" /grant "%USERNAME%":(OI)(CI)F /T /C /Q >nul 2>&1

:: 3. На всякий случай выдаем права группе "Пользователи" (код S-1-5-32-545)
:: Это страховка: если скрипт не угадал имя, это откроет доступ всем юзерам этого ПК.
icacls "%TARGET_FOLDER%" /grant *S-1-5-32-545:(OI)(CI)F /T /C /Q >nul 2>&1

echo ==========================
echo GOTOVO! Okna propadut.
echo ==========================
timeout /t 3
