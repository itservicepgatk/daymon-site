@echo off
:: Получаем права владельца на папку Рабочий стол
takeown /F "%USERPROFILE%\Desktop" /R /D Y

:: Выдаем полные права группе "Все" (на русском и английском на всякий случай)
icacls "%USERPROFILE%\Desktop" /grant "Все":(OI)(CI)F /T /C
icacls "%USERPROFILE%\Desktop" /grant "Everyone":(OI)(CI)F /T /C
icacls "%USERPROFILE%\Desktop" /grant "%USERNAME%":(OI)(CI)F /T /C

echo.
echo GOTOVO!
timeout /t 3
